# Optional secret for packing custom configurator links (?k=...). Change in production.
# VITE_CONFIG_PACK_SECRET=your-random-secret

# Facebook (Meta) Pixel ID for configurator events.
# Without this variable the pixel does not load and triggers are not sent.
# VITE_FB_PIXEL_ID=1234567890123456

# Formspree: leads from the configurator are sent to your email.
# 1) Go to https://formspree.io and create a form.
# 2) Set the email to receive messages (e.g. egor@ubernatural.io).
# 3) The form URL will contain an id, e.g. https://formspree.io/f/xyzabc — use xyzabc here.
# VITE_FORMSPREE_ID=xyzabc

# Telegram: send leads to a Telegram bot instead (optional; overrides Formspree when set).
# 1) Create a bot via @BotFather, get token.
# 2) Message your bot in Telegram (e.g. /start), then run: TELEGRAM_BOT_TOKEN=xxx node api/get-chat-id.js
# 3) Set TELEGRAM_CHAT_ID and run api/server.js (locally or on VPS). Nginx proxy /api to the server.
# VITE_SEND_LEAD_API_URL=http://your-domain/api/send-lead
# TELEGRAM_BOT_TOKEN=your_bot_token
# Password that users send to the bot in Telegram to receive leads (default: thank_you_egor)
# TELEGRAM_BOT_PASSWORD=thank_you_egor
